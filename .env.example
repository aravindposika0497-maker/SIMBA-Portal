# SIMBA Data Lake Portal configuration.
# On EC2 this file lives at /etc/simba-portal/simba-portal.env (owner root:simba, mode 640).
# NEVER put secrets in the frontend, in git, or in chat. Prefer SIMBA_DATABRICKS_SECRET_ID.

# ---------------------------------------------------------------- mode
# Keep true until a real query against the approved Databricks workspace has been verified.
SIMBA_DEMO_MODE=true
SIMBA_ENVIRONMENT_LABEL=NON-PRODUCTION

# ---------------------------------------------------------------- authentication
# alb-oidc = users sign in through the ALB (company IdP). Required before anyone else uses the portal.
# none     = setup/testing only, on a private network. The UI shows a red warning.
SIMBA_AUTH_MODE=none
# Local demo login only. Replace the example values before starting the portal.
SIMBA_DEMO_LOGIN_REQUIRED=true
SIMBA_DEMO_USERNAME=demo-user
SIMBA_DEMO_PASSWORD=replace-with-a-unique-demo-password
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SIMBA_SESSION_SECRET=replace-with-at-least-32-random-characters
# Set true when the portal is served over HTTPS; leave false for local HTTP testing only.
SIMBA_COOKIE_SECURE=false
# ARN of the ALB that fronts this instance (required for alb-oidc), e.g. arn:aws:elasticloadbalancing:eu-west-1:<account>:loadbalancer/app/<name>/<id>
SIMBA_ALB_ARN=
# Optional comma-separated email domains allowed in (leave blank to allow anyone the IdP lets through)
SIMBA_ALLOWED_EMAIL_DOMAINS=
AWS_REGION=eu-west-1

# ---------------------------------------------------------------- Databricks (live mode)
# Workspace host WITHOUT https://, and the SQL Warehouse HTTP path (Warehouse > Connection details)
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
# oauth-m2m (service principal, recommended) or pat
DATABRICKS_AUTH_TYPE=oauth-m2m
# Recommended: Secrets Manager secret holding {"client_id": "...", "client_secret": "..."}
# (read with the EC2 instance profile; nothing secret stored on disk)
SIMBA_DATABRICKS_SECRET_ID=
# Fallback only if Secrets Manager is not available:
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_TOKEN=

# ---------------------------------------------------------------- Unity Catalog scope
SIMBA_CATALOG=simba_data_poc
SIMBA_LAYER_SCHEMAS=bronze,silver,gold
SIMBA_KAFKA_EVENTS_TABLE=simba_data_poc.bronze.kafka_events
# Fully qualified, approved, masked tables/views that may be previewed (comma-separated)
SIMBA_SAMPLE_TABLES=
SIMBA_SAMPLE_ROW_LIMIT=10
# Extra masking backstop by column-name substring (defaults cover email, phone, bvn, name, account_number ...)
# SIMBA_MASK_COLUMN_PATTERNS=
SIMBA_ROW_COUNTS=true
SIMBA_ROW_COUNT_MAX_TABLES=50
SIMBA_HISTORY_MAX_TABLES=50
SIMBA_LINEAGE_LOOKBACK_DAYS=90
# Databricks job ids whose recent runs appear on the Architecture page (comma-separated)
SIMBA_DATABRICKS_JOB_IDS=

# ---------------------------------------------------------------- refresh / cost control
# Kafka activity + job runs
SIMBA_FAST_REFRESH_SECONDS=30
# Inventory, row counts, lineage, grants
SIMBA_SLOW_REFRESH_SECONDS=600
# Stop querying after this long with no viewers, so the SQL Warehouse can auto-stop
SIMBA_IDLE_PAUSE_SECONDS=900
SIMBA_MAX_STREAMS=24
SIMBA_GUNICORN_THREADS=32

# ---------------------------------------------------------------- request links (blank = shown as "not configured")
SIMBA_LINK_SERVICE_PORTAL=
SIMBA_LINK_REQUEST_ACCESS=
SIMBA_LINK_REQUEST_DATASET=
SIMBA_SUPPORT_EMAIL=
